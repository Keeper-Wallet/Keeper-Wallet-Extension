.root
  display: flex;
  flex-direction: column;
  padding: 20px 0 0;
  height: calc(100% - 48px);
  overflow: hidden;

.checkbox.checkbox // for increased specificity
  margin-right: 0;

.centered
  margin-right: 48px;
  margin-left: 48px;

.accounts
  flex: 1 1 0;
  border-top: 1px solid #edf0f4;
  background: #f8f9fb;
  overflow: auto;

.accountsGroup
  position: relative;

.accountsGroupHeader
  position: sticky;
  z-index: 1;
  top: 0;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #edf0f4;
  padding: 10px 41px;
  background: #fff;

.accountsGroupIcon
  margin: 0 8px 2px 0;

.accountsGroupLabel
  margin-right: auto;
  color: #9ba6b2;
  font-size: 12px;
  font-weight: 300;

.walletTypeLabel
  margin-left: 8px;
  padding: 2px 6px;
  background-color: #f0f2f5;
  border-radius: 4px;
  color: #5e6c84;
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  display: inline-block;
  vertical-align: middle;

.networkList
  padding: 8px 35px 8px 60px;
  background-color: #f8f9fb;

.networkItem
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  border-bottom: 1px solid #edf0f4;
  font-size: 12px;
  color: #4e5c6e;

.networkItem:last-child
  border-bottom: none;

.accountList
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px 35px;

.accountListItem
  display: flex;
  padding: 0 16px 0 14px;

.accountInfo
  display: flex;
  align-items: center;
  width: 100%;

.accountInfoText
  display: flex;
  flex-direction: column;
  gap: 2px;

.accountName
  font-size: 12px;
  line-height: 14px;
  word-break: break-word;

.accountInfoNote
  color: var(--color-disabled500);
  margin-right: 24px;

.buttons
  border-top: 1px solid #edf0f4;
  padding: 24px 48px;
