@import './../../../styles/colors.styl';

.root
  overflow: auto;
  padding: 0 48px;

.importIcon
  display: block;
  margin: auto;
  width: 183
  height: 117
  object-fit: contain;

.separator
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 20px 0;

  &:before,
  &:after
    content: "";
    flex: 1 1 0;
    border-bottom: 1px solid $accent50;

.separatorBtns
  button
    &:not(:last-child)
      margin-bottom: 12px;

.importButtonsItem
  display: flex
  align-items: center
  padding: 14px 0

  &:first-child
    padding-top: 0;

  &:not(:last-child)
    border-bottom: 1px solid $accent50

.importButton {
  flex: 1;
  text-align: left;
  background: none;
  border: none;
  padding: 0;
  font-size: 14px;
  font-weight: 600;
}

.importButton:disabled {
  opacity: 0.5;
}

.importButtonIcon {
  width: 25px;
  height: 28px;
}

.importButtonNote {
  color: var(--color-basic500);
  font-size: 12px;
}

.iconWithBadge {
  margin-right: 12px;
  position: relative;
  display: inline-block;
}

.badge {
  position: absolute;
  right: -5px;
  bottom: -3px;
  background-color: #fff;
  border: 1px solid #DAE1E9;
  border-radius: 50%;
  width: 13px;
  height: 13px;
  padding: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
